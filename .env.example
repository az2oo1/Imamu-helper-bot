# Database Connection (from imamu-helper)
DATABASE_URL="postgresql://root@100.70.48.23:26257/defaultdb?sslmode=disable"
SQL_HOST="100.70.48.23"
SQL_PORT="26257"
SQL_USER="root"
SQL_PASSWORD=""
SQL_DB_NAME="defaultdb"
SQL_SSL="false"

# Bot Behavior Settings
# If set to true, requests from numbers NOT in the imamu-helper database will be automatically rejected.
# If set to false, unrecognized requests will be ignored and left pending for manual admin approval.
AUTO_REJECT_UNRECOGNIZED="false"

# Admin phone numbers allowed to issue bot commands (comma-separated, in international format e.g. 966500000000)
ADMIN_NUMBERS="966500000000"

# Health check & Web Dashboard Port
PORT=3001

# Optional Pairing Code mode (set to true and provide phone number to connect using pairing code instead of QR)
USE_PAIRING_CODE="false"
PAIRING_PHONE_NUMBER=""
